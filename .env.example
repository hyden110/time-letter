# 复制为 .env 后按需修改（开发期仅本地使用，禁止提交真实密钥）
NODE_ENV=development
PORT=3000

# 支付开关：默认 false。一期不接真实支付；false 时提交后直入「保管中」，订单金额 0。
PAYMENT_ENABLED=false

# 存储模式：memory（默认，单测/e2e 用，不连数据库） | postgres（需同时配置 DATABASE_URL）
STORAGE_MODE=memory

# 本地中间件（docker compose up -d）
DATABASE_URL=postgres://timeletter:timeletter@localhost:5432/timeletter
REDIS_URL=redis://localhost:6379

# 邮件（开发期走 mailpit 沙箱，Web UI: http://localhost:8025）
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@timeletter.local

# 短信 provider：mock（生产服务商由业务方选型，变量清单见 docs/sms-template-variables.md）
SMS_PROVIDER=mock

# 微信内容安全 API：mock（生产接入需小程序资质与密钥，通过 KMS 注入）
MODERATION_WECHAT_MODE=mock

# 信件正文静态加密密钥（US-009，AES-256-GCM）。启动时强校验，未配置直接拒绝启动。
# 必须是 32 字节：64 位十六进制或 base64。生成方式（任选其一）：
#   openssl rand -hex 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 本地开发每个环境各生成一份；正式环境由 KMS/独立密钥服务注入，禁止写入代码或提交仓库。
# 换密钥会导致既有密文无法解密，请妥善备份。
LETTER_ENCRYPTION_KEY=

# 建表与索引（首次或迁移文件变更后执行；幂等，已应用的迁移会跳过）
#   pnpm --filter @timeletter/api run migrate
